# PostgreSQL Database configuration
POSTGRES_DB=echotalk
POSTGRES_USER=echotalk
POSTGRES_PASSWORD=echotalk_secret

# Spring Boot / Backend Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/echotalk
SPRING_DATASOURCE_USERNAME=echotalk
SPRING_DATASOURCE_PASSWORD=echotalk_secret

# Redis Configuration
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=echotalk-super-secret-jwt-key-change-in-production-2024

# SocketIO
SOCKETIO_PORT=8081

# Frontend WebRTC relay configuration
VITE_TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
VITE_TURN_USERNAME=echotalk
VITE_TURN_CREDENTIAL=change-this-turn-password

# Transactional email
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=no-reply@echotalk.local
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
FRONTEND_URL=http://localhost:5173

# Optional LibreTranslate-compatible endpoint
TRANSLATION_URL=
